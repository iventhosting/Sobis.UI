@namespace Sobis.UI
@inherits SbsComponentBase

<div class="@RootClass" style="@RootStyle" @attributes="UserAttributes">
    @if (HasHeader)
    {
        <div class="@HeadClass"
             role="@(Collapsible ? "button" : null)"
             tabindex="@(Collapsible ? 0 : null)"
             aria-expanded="@(Collapsible ? (!Collapsed).ToString().ToLowerInvariant() : null)"
             @onclick="OnHeaderClickAsync"
             @onkeydown="OnHeaderKeyDownAsync">
            <div class="sbs-form-group-head-title">
                @if (!string.IsNullOrEmpty(Icon))
                {
                    <i class="@Icon" aria-hidden="true"></i>
                }
                @if (!string.IsNullOrEmpty(Caption))
                {
                    <span>@Caption</span>
                }
            </div>
            @if (HeaderContent is not null)
            {
                <div class="sbs-form-group-head-extra" @onclick:stopPropagation="true">
                    @HeaderContent
                </div>
            }
            @if (Collapsible)
            {
                <i class="fa-solid fa-chevron-down sbs-form-group-chevron @(Collapsed ? "sbs-collapsed" : "")" aria-hidden="true"></i>
            }
        </div>
    }

    @if (!Collapsed)
    {
        <div class="@BodyClass" style="@BodyStyle">
            <CascadingValue Value="_context" IsFixed="false">
                @ChildContent
            </CascadingValue>
        </div>

        @if (FooterContent is not null)
        {
            <div class="sbs-form-group-footer">
                @FooterContent
            </div>
        }
    }
</div>

@code {
    /// <summary>Header caption text.</summary>
    [Parameter] public string Caption { get; set; } = "";

    /// <summary>Optional header icon CSS class (e.g. "fa fa-search").</summary>
    [Parameter] public string Icon { get; set; } = "";

    /// <summary>Allows collapsing/expanding the form group by clicking its header.</summary>
    [Parameter] public bool Collapsible { get; set; }

    /// <summary>Current collapsed state when Collapsible is enabled.</summary>
    [Parameter] public bool Collapsed { get; set; }

    /// <summary>Two-way binding callback for Collapsed.</summary>
    [Parameter] public EventCallback<bool> CollapsedChanged { get; set; }

    /// <summary>Number of internal grid columns for form fields. Defaults to 1 (vertical flow).</summary>
    [Parameter] public int Columns { get; set; } = 1;

    /// <summary>Visually dims and disables interaction for the form group body and cascades Disabled to child inputs.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Optional custom header actions/badges rendered on the right side of the header.</summary>
    [Parameter] public RenderFragment? HeaderContent { get; set; }

    /// <summary>Optional footer bar rendered below the body.</summary>
    [Parameter] public RenderFragment? FooterContent { get; set; }

    /// <summary>Column span when placed inside SbsGridLayout or multi-column SbsFormLayout.</summary>
    [Parameter] public int? ColSpan { get; set; }

    /// <summary>Stretches the form group to fill parent height (useful in equal-height rows or aux panels).</summary>
    [Parameter] public bool FillHeight { get; set; }

    /// <summary>Optional label width override cascaded to child SbsField items.</summary>
    [Parameter] public string? LabelWidth { get; set; }

    /// <summary>Optional label position override cascaded to child SbsField items.</summary>
    [Parameter] public SbsLabelPosition? LabelPosition { get; set; }

    /// <summary>Form group body content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [CascadingParameter] private SbsFormContext? ParentFormContext { get; set; }

    private readonly SbsFormContext _context = new();

    private bool EffectiveDisabled => Disabled || (ParentFormContext?.Disabled ?? false);

    private bool HasHeader =>
        !string.IsNullOrEmpty(Caption) || !string.IsNullOrEmpty(Icon) || HeaderContent is not null || Collapsible;

    protected override void OnParametersSet()
    {
        _context.Disabled = EffectiveDisabled;
        _context.ReadOnly = ParentFormContext?.ReadOnly ?? false;
        _context.LabelWidth = !string.IsNullOrWhiteSpace(LabelWidth) ? LabelWidth : ParentFormContext?.LabelWidth;
        _context.LabelPosition = LabelPosition ?? ParentFormContext?.LabelPosition ?? SbsLabelPosition.Left;
        _context.Compact = ParentFormContext?.Compact ?? true;
        _context.Size = ParentFormContext?.Size ?? SbsSize.Md;
    }

    private string RootClass => BuildClass(
        CreateCssBuilder("sbs-form-group")
            .AddClass("sbs-form-group-disabled", EffectiveDisabled)
            .AddClass("sbs-form-group-fill", FillHeight)
            .AddClass("sbs-form-group-collapsed", Collapsed));

    private string? RootStyle => BuildStyle(
        CreateStyleBuilder()
            .AddStyle("grid-column", $"span {ColSpan}", ColSpan is > 0));

    private string HeadClass => CssBuilder.Default("sbs-form-group-head")
        .AddClass("sbs-form-group-head-collapsible", Collapsible)
        .AddClass("sbs-form-group-head-collapsed", Collapsed)
        .ToString();

    private string BodyClass => CssBuilder.Default("sbs-form-group-body")
        .AddClass("sbs-form-group-body-cols", Columns > 1)
        .ToString();

    private string? BodyStyle => StyleBuilder.Empty()
        .AddStyle("--sbs-fg-cols", $"repeat({Columns}, minmax(0, 1fr))", Columns > 1)
        .Build();

    private async Task ToggleCollapsedAsync()
    {
        if (!Collapsible)
            return;

        Collapsed = !Collapsed;
        await CollapsedChanged.InvokeAsync(Collapsed);
    }

    private Task OnHeaderClickAsync() => ToggleCollapsedAsync();

    private Task OnHeaderKeyDownAsync(KeyboardEventArgs e)
    {
        if (Collapsible && (e.Key == "Enter" || e.Key == " "))
            return ToggleCollapsedAsync();

        return Task.CompletedTask;
    }
}
