name: CI & NuGet Release

on:
  push:
    branches: [ main ]
    tags: [ 'v*' ]
  pull_request:
    branches: [ main ]

jobs:
  build-test-pack:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Setup .NET 10
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: '10.0.x'

      - name: Restore
        run: dotnet restore src/Sobis.UI/Sobis.UI.csproj && dotnet restore tests/Sobis.UI.Tests/Sobis.UI.Tests.csproj

      - name: Build
        run: dotnet build src/Sobis.UI/Sobis.UI.csproj -c Release --no-restore

      - name: Run Verification Suite
        run: dotnet run --project tests/Sobis.UI.Tests/Sobis.UI.Tests.csproj -c Release

      - name: Pack NuGet
        run: dotnet pack src/Sobis.UI/Sobis.UI.csproj -c Release -o artifacts/nuget --no-build

      - name: Upload Package Artifact
        uses: actions/upload-artifact@v4
        with:
          name: Sobis.UI-NuGet
          path: artifacts/nuget/*.nupkg

      - name: Publish to NuGet.org (on v* tag)
        if: startsWith(github.ref, 'refs/tags/v') && secrets.NUGET_API_KEY != ''
        run: dotnet nuget push artifacts/nuget/*.nupkg --api-key ${{ secrets.NUGET_API_KEY }} --source https://api.nuget.org/v3/index.json --skip-duplicate
